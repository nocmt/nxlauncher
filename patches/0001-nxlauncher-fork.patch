diff --git a/dm/host/front_gamepad_mac.m b/dm/host/front_gamepad_mac.m
new file mode 100644
index 0000000..216d318
--- /dev/null
+++ b/dm/host/front_gamepad_mac.m
@@ -0,0 +1,100 @@
+// Physical controllers on the Mac (GameController framework): a Switch Pro Controller, Joy-Cons, an
+// Xbox pad, a PS pad, ... The state goes to the host through dm_pad_set, the same path the iOS app
+// uses, so it is ORed with the Mac keyboard (dm_input_set) and neither overrides the other; a stick
+// takes whichever of the two is deflected further.
+//
+// The four face buttons are mapped by the glyph on the button, not by its position: the system gives
+// them by position (A bottom, B right, X left, Y top), which on a Nintendo pad means B bottom / A
+// right / Y left / X top. dm_padmap.h tells the two layouts apart (a Nintendo pad is recognized by
+// its product category, e.g. "Switch Pro Controller"), so a Switch Pro Controller keeps the
+// Nintendo letters and an Xbox pad keeps its own. DM_PADMAP=nintendo|xbox forces the layout.
+//
+// A pad is best connected over Bluetooth: macOS exposes a USB Nintendo controller as a plain HID
+// gamepad, which the GameController framework does not always pick up.
+#import <Cocoa/Cocoa.h>
+#import <GameController/GameController.h>
+#include <pthread.h>
+#include "dm.h"
+#include "dm_input.h"
+#include "dm_padmap.h"
+
+static pthread_mutex_t g_mu = PTHREAD_MUTEX_INITIALIZER;
+static uint64_t g_btn;
+static int32_t g_lx, g_ly, g_rx, g_ry;
+
+static int32_t axis(float v) { return (int32_t)(fmaxf(-1.f, fminf(1.f, v)) * 32767); }
+
+static void publish(void) {
+    pthread_mutex_lock(&g_mu);
+    uint64_t b = g_btn;
+    int32_t lx = g_lx, ly = g_ly, rx = g_rx, ry = g_ry;
+    pthread_mutex_unlock(&g_mu);
+    dm_pad_set(b, lx, ly, rx, ry);
+}
+
+static void read_pad(GCExtendedGamepad *g, int kind) {
+    uint64_t m = 0;
+    // by the glyph: a Nintendo pad has A right / B bottom / X top / Y left, an Xbox pad A bottom / B right / X left / Y top
+    m |= dm_padmap_face(kind, g.buttonA.isPressed, g.buttonB.isPressed, g.buttonX.isPressed, g.buttonY.isPressed);
+    #define K(el, bit) if ((el).isPressed) m |= (bit)   // the DM_BTN_* values are masks, not bit indexes
+    K(g.leftShoulder, DM_BTN_L); K(g.rightShoulder, DM_BTN_R);
+    K(g.leftTrigger, DM_BTN_ZL); K(g.rightTrigger, DM_BTN_ZR);
+    K(g.buttonMenu, DM_BTN_PLUS); K(g.buttonOptions, DM_BTN_MINUS);
+    K(g.leftThumbstickButton, DM_BTN_LS); K(g.rightThumbstickButton, DM_BTN_RS);
+    K(g.dpad.left, DM_BTN_LEFT); K(g.dpad.up, DM_BTN_UP); K(g.dpad.right, DM_BTN_RIGHT); K(g.dpad.down, DM_BTN_DOWN);
+    #undef K
+    pthread_mutex_lock(&g_mu);
+    g_btn = m;
+    g_lx = axis(g.leftThumbstick.xAxis.value); g_ly = axis(g.leftThumbstick.yAxis.value);
+    g_rx = axis(g.rightThumbstick.xAxis.value); g_ry = axis(g.rightThumbstick.yAxis.value);
+    pthread_mutex_unlock(&g_mu);
+    publish();
+}
+
+static void pads_changed(void) {
+    int n = 0;
+    // DM_PADMAP=nintendo|xbox forces the layout when the automatic detection gets it wrong
+    static int forced = -1;
+    if (forced < 0) {
+        forced = 0;
+        const char *e = getenv("DM_PADMAP");
+        if (e) {
+            if (!strcasecmp(e, "nintendo")) forced = DM_PADKIND_NINTENDO;
+            else if (!strcasecmp(e, "xbox")) forced = DM_PADKIND_XBOX;
+        }
+    }
+    for (GCController *c in GCController.controllers) {
+        GCExtendedGamepad *g = c.extendedGamepad;
+        if (!g) continue;
+        n++;
+        int kind = forced ? forced : dm_padmap_kind(c.productCategory.UTF8String, c.vendorName.UTF8String);
+        g.valueChangedHandler = ^(GCExtendedGamepad *gg, GCControllerElement *el) { (void)el; read_pad(gg, kind); };
+        read_pad(g, kind);
+        LOG("[gamepad] controller: vendor '%s', category '%s' -> %s layout", c.vendorName.UTF8String ?: "?", c.productCategory.UTF8String ?: "?",
+            kind == DM_PADKIND_NINTENDO ? "Nintendo (A right / B bottom / X top / Y left)" : "Xbox (A bottom / B right / X left / Y top)");
+    }
+    if (!n) {   // no pad: let go of everything, so a button held while the pad was unplugged does not stick
+        pthread_mutex_lock(&g_mu);
+        g_btn = 0; g_lx = g_ly = g_rx = g_ry = 0;
+        pthread_mutex_unlock(&g_mu);
+        publish();
+    }
+    LOG("[gamepad] %d controller(s) on the Mac", n);
+}
+
+void dm_mac_gamepad_start(void) {
+    NSNotificationCenter *nc = NSNotificationCenter.defaultCenter;
+    [nc addObserverForName:GCControllerDidConnectNotification object:nil queue:[NSOperationQueue mainQueue]
+                  usingBlock:^(NSNotification *note) { (void)note; pads_changed(); }];
+    [nc addObserverForName:GCControllerDidDisconnectNotification object:nil queue:[NSOperationQueue mainQueue]
+                  usingBlock:^(NSNotification *note) { (void)note; pads_changed(); }];
+    pads_changed();
+}
+
+// Losing the focus: a button held while switching away gets no "release", so let go of everything
+void dm_mac_gamepad_reset(void) {
+    pthread_mutex_lock(&g_mu);
+    g_btn = 0; g_lx = g_ly = g_rx = g_ry = 0;
+    pthread_mutex_unlock(&g_mu);
+    publish();
+}
