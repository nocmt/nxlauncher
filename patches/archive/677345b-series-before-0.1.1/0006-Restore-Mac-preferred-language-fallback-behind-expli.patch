From 2b42c48bb21ab22cf0ae9ee13a9f8a112bf40923 Mon Sep 17 00:00:00 2001
From: nocmt <nocmtone@gmail.com>
Date: Thu, 22 Oct 2026 12:04:29 +0800
Subject: [PATCH 6/6] Restore Mac preferred-language fallback behind explicit
 DM_LANG

Upstream 54eac07 replaced iOS implicit language selection with a validated IPA DMLanguage choice, passed through DM_LANG; retain that behavior. Restore only the legacy Mac first-preference zh-Hans/en-US fallback. Do not resurrect the removed dm_i18n UI tables, game-specific save parsing or fixed language indices. Explicit language codes remain verbatim, including non-Chinese/English values. Keep this local: its two-language fallback is not a general upstream language solution.
---
diff --git a/dm/host/hle_oe.c b/dm/host/hle_oe.c
index 5d736475a8f4f1849168c78bc3069976ba2ec50b..81fe1d9c2bfe4e7e552aaefc0d031a98518fc5df 100644
--- a/dm/host/hle_oe.c
+++ b/dm/host/hle_oe.c
@@ -1,7 +1,11 @@
 // nn::oe (application operating environment): on the real device the console state is queried through the am/oe services; the host gives fixed state directly.
 // oe::Initialize is in hle_sdkinit.c, not here.
-// Environment switches: DM_OPMODE=0 handheld / 1 console (default: the profile's op_mode, console unless set; console corresponds to the console-mode render profile); DM_LANG=language code (default en-US; the iOS app sets it from the IPA's DMLanguage, main.m).
+// Environment switches: DM_OPMODE=0 handheld / 1 console (default: the profile's op_mode, console unless set; console corresponds to the console-mode render profile); DM_LANG=language code (Mac fallback: preferred system language mapped to zh-Hans/en-US; iOS: IPA DMLanguage, otherwise en-US).
 #include "hle.h"
+#include <TargetConditionals.h>
+#if TARGET_OS_OSX
+#include <CoreFoundation/CoreFoundation.h>
+#endif
 
 // The operation mode is runtime state (the front end can change it: iOS overheat downgrade switches to handheld): the single source is here, taken once from DM_OPMODE at startup, the environment variable is not read again afterwards
 #include <stdatomic.h>
@@ -206,11 +210,40 @@ HLE_FORCE("_ZN2nn2oe28SetResumeNotificationEnabledEb", "resume notification swit
 HLE_FORCE("_ZN2nn2oe42SetOperationModeChangedNotificationEnabledEb", "operation mode change notification switch", void, h_oe_SetOpModeNtf, unsigned on) { g_ntf_opmode = on & 0xff; }
 HLE_FORCE("_ZN2nn2oe44SetPerformanceModeChangedNotificationEnabledEb", "performance mode change notification switch", void, h_oe_SetPerfModeNtf, unsigned on) { g_ntf_perfmode = on & 0xff; }
 
+// Legacy Mac fallback only: Chinese/Sinitic preferred tags select Simplified Chinese;
+// other tags select English. Explicit DM_LANG is copied verbatim below, including languages
+// outside this fallback. iOS keeps the upstream IPA DMLanguage -> DM_LANG selection.
+#if TARGET_OS_OSX
+static const char *mac_language_tag(const char *tag) {
+    char primary[4] = {0}; unsigned i = 0;
+    while (tag && tag[i] && tag[i] != '-' && tag[i] != '_' && i < 3) { primary[i] = tag[i] | 0x20; i++; }
+    static const char *const chinese[] = {"zh", "yue", "wuu", "hak", "nan", "cmn", "gan", "hsn", "lzh"};
+    for (unsigned j = 0; j < sizeof chinese / sizeof *chinese; j++)
+        if (!strcmp(primary, chinese[j])) return "zh-Hans";
+    return "en-US";
+}
+static const char *mac_system_language(void) {
+    const char *code = "en-US";
+    CFArrayRef languages = CFLocaleCopyPreferredLanguages();
+    if (languages) {
+        char tag[128];
+        if (CFArrayGetCount(languages) > 0 && CFStringGetCString((CFStringRef)CFArrayGetValueAtIndex(languages, 0), tag, sizeof tag, kCFStringEncodingUTF8))
+            code = mac_language_tag(tag);
+        CFRelease(languages);
+    }
+    return code;
+}
+#endif
 // nn::settings::LanguageCode = struct { char string[8]; }, 8 bytes returned by value in x0
-HLE_FORCE("_ZN2nn2oe18GetDesiredLanguageEv", "system language query; value from DM_LANG", uint64_t, h_oe_GetLang, void) {
+HLE_FORCE("_ZN2nn2oe18GetDesiredLanguageEv", "system language query; DM_LANG, otherwise Mac preferred language or en-US", uint64_t, h_oe_GetLang, void) {
     const char *e = getenv("DM_LANG");
     char code[8] = {0};
-    strncpy(code, e && *e ? e : "en-US", sizeof code - 1);
+    if (e && *e) strncpy(code, e, sizeof code - 1);
+#if TARGET_OS_OSX
+    else strncpy(code, mac_system_language(), sizeof code - 1);
+#else
+    else strncpy(code, "en-US", sizeof code - 1);
+#endif
     uint64_t v; memcpy(&v, code, 8);
     return v;
 }
diff --git a/dm/host/tests/Makefile b/dm/host/tests/Makefile
index e6453fce4f7603d2a4047fb5ad2e6dd5812a67d4..5529b5cee13887546e2e45ddb58a76839666af30 100644
--- a/dm/host/tests/Makefile
+++ b/dm/host/tests/Makefile
@@ -4,7 +4,8 @@ B = build
 # tests that use the game profile need GAME=<base game title ID> (there is no default game); GINC only expands when used, so tests without the profile build as before
 GINC = $(if $(strip $(GAME)),-I../gen/$(GAME) -I../../games/$(GAME),$(error GAME is not set: make GAME=<base game title ID>: $(shell python3 ../../games/game.py list | awk -F'\t' '{printf "%s (%s)  ", $$1, $$3}')))
 GAME_H = ../gen/$(GAME)/game_profile.h
-run: $(B)/t_mem_config $(B)/t_padmap $(B)/t_touch $(B)/t_oe $(B)/t_fs $(B)/t_fs_commit_list $(B)/t_thread_leak $(B)/t_fs_case $(B)/t_audio $(B)/t_audio_spsc $(B)/t_swkbd $(B)/t_altstack $(B)/t_condvar $(B)/t_condvar_old $(B)/t_pctl $(B)/t_time
+run: $(B)/t_language $(B)/t_mem_config $(B)/t_padmap $(B)/t_touch $(B)/t_oe $(B)/t_fs $(B)/t_fs_commit_list $(B)/t_thread_leak $(B)/t_fs_case $(B)/t_audio $(B)/t_audio_spsc $(B)/t_swkbd $(B)/t_altstack $(B)/t_condvar $(B)/t_condvar_old $(B)/t_pctl $(B)/t_time
+	$(B)/t_language
 	$(B)/t_mem_config
 	$(B)/t_padmap
 	$(B)/t_touch
@@ -21,6 +22,8 @@ run: $(B)/t_mem_config $(B)/t_padmap $(B)/t_touch $(B)/t_oe $(B)/t_fs $(B)/t_fs_
 	$(B)/t_condvar_old
 	$(B)/t_pctl
 	$(B)/t_time
+$(B)/t_language: t_language.c t_oe.c ../hle_oe.c ../hle.h ../dm.h $(GAME_H) | $(B)
+	clang -O1 -Wall -Werror -Wno-unused-function -I.. $(GINC) -o $@ t_language.c -framework CoreFoundation
 $(B)/t_mem_config: t_mem_config.c ../dm_mem_config.h | $(B)
 	clang -O1 -Wall -Werror -fsanitize=undefined -o $@ t_mem_config.c
 $(B)/t_padmap: t_padmap.c ../dm_padmap.h ../dm_input.h | $(B)
@@ -52,7 +55,7 @@ $(B)/t_pctl: t_pctl.c ../hle_misc.c ../hle.h ../dm.h $(GAME_H) | $(B)
 $(B)/t_time: t_time.c ../hle_time.c ../hle.h ../dm.h $(GAME_H) | $(B)
 	clang -O1 -Wall -Werror -Wno-unused-function -I.. $(GINC) -o $@ t_time.c
 $(B)/t_oe: t_oe.c ../hle_oe.c ../hle.h ../dm.h $(GAME_H) | $(B)
-	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_oe.c
+	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_oe.c -framework CoreFoundation
 $(B)/t_condvar: t_condvar.c t_condvar_stub.c ../hle_thread.c ../dm.h $(GAME_H) | $(B)
 	clang -O1 -Wno-unused-function -DDM_TEST_HOOKS -I.. $(GINC) -o $@ t_condvar.c t_condvar_stub.c ../hle_thread.c
 $(B)/t_condvar_old: t_condvar.c t_condvar_stub.c ../hle_thread.c ../dm.h $(GAME_H) | $(B)
diff --git a/dm/host/tests/t_language.c b/dm/host/tests/t_language.c
new file mode 100644
index 0000000000000000000000000000000000000000..68713930992d5df36f4141caef51d6502ae0f370
--- /dev/null
+++ b/dm/host/tests/t_language.c
@@ -0,0 +1,33 @@
+// Reuse the oe service test's host stubs without running its notification suite twice.
+#define main oe_notification_test_main
+#include "t_oe.c"
+#undef main
+#include <assert.h>
+static void expect_code(const char *want) {
+    uint64_t result = h_oe_GetLang(); char code[8]; memcpy(code, &result, 8);
+    assert(!strcmp(code, want));
+}
+int main(void) {
+#if TARGET_OS_OSX
+    const char *zh[] = {"zh-Hans-CN", "zh-Hant-TW", "ZH_hk", "yue-Hant-HK", "wuu", "hak", "nan", "cmn", "gan", "hsn", "lzh"};
+    for (unsigned i = 0; i < sizeof zh / sizeof *zh; i++) assert(!strcmp(mac_language_tag(zh[i]), "zh-Hans"));
+    assert(!strcmp(mac_language_tag(NULL), "en-US"));
+    assert(!strcmp(mac_language_tag("ja-JP"), "en-US"));
+    assert(!strcmp(mac_language_tag("de-DE"), "en-US"));
+#endif
+    const char *explicit[] = {"ja", "de", "fr", "zh-Hant", "zh-Hans", "en-GB", "es-419"};
+    for (unsigned i = 0; i < sizeof explicit / sizeof *explicit; i++) { setenv("DM_LANG", explicit[i], 1); expect_code(explicit[i]); }
+    unsetenv("DM_LANG");
+#if TARGET_OS_OSX
+    expect_code(mac_system_language());
+#else
+    expect_code("en-US");
+#endif
+    setenv("DM_LANG", "", 1);
+#if TARGET_OS_OSX
+    expect_code(mac_system_language());
+#else
+    expect_code("en-US");
+#endif
+    puts("language: legacy tag fallback and verbatim explicit DM_LANG precedence passed");
+}
