diff --git a/dm/host/tests/t_language.c b/dm/host/tests/t_language.c
new file mode 100644
index 0000000000000000000000000000000000000000..302fa0d2406958acb4f164e0f0334028c052cc7e
--- /dev/null
+++ b/dm/host/tests/t_language.c
@@ -0,0 +1,38 @@
+// Reuse the oe service test's host stubs without running its notification suite twice.
+#define main oe_notification_test_main
+#include "t_oe.c"
+#undef main
+#include <assert.h>
+static void expect_code(const char *want) {
+    uint64_t result = h_oe_GetLang(); char code[8]; memcpy(code, &result, 8);
+    assert(!strcmp(code, want));
+    int region = !strncmp(want, "ja", 2) ? 0 :
+        !strncmp(want, "ko", 2) || !strncmp(want, "zh", 2) ? 4 :
+        !strcmp(want, "en-US") || !strcmp(want, "fr-CA") ||
+        !strcmp(want, "es-419") || !strcmp(want, "pt-BR") ? 1 : 2;
+    assert(h_oe_GetRegion() == region);
+}
+int main(void) {
+#if TARGET_OS_OSX
+    const char *zh[] = {"zh-Hans-CN", "zh-Hant-TW", "ZH_hk", "yue-Hant-HK", "wuu", "hak", "nan", "cmn", "gan", "hsn", "lzh"};
+    for (unsigned i = 0; i < sizeof zh / sizeof *zh; i++) assert(!strcmp(mac_language_tag(zh[i]), "zh-Hans"));
+    assert(!strcmp(mac_language_tag(NULL), "en-US"));
+    assert(!strcmp(mac_language_tag("ja-JP"), "en-US"));
+    assert(!strcmp(mac_language_tag("de-DE"), "en-US"));
+#endif
+    const char *explicit[] = {"ja", "ko", "de", "fr", "fr-CA", "pt-BR", "zh-Hant", "zh-Hans", "en-US", "en-GB", "es-419"};
+    for (unsigned i = 0; i < sizeof explicit / sizeof *explicit; i++) { setenv("DM_LANG", explicit[i], 1); expect_code(explicit[i]); }
+    unsetenv("DM_LANG");
+#if TARGET_OS_OSX
+    expect_code(mac_system_language());
+#else
+    expect_code("en-US");
+#endif
+    setenv("DM_LANG", "", 1);
+#if TARGET_OS_OSX
+    expect_code(mac_system_language());
+#else
+    expect_code("en-US");
+#endif
+    puts("language: legacy tag fallback and verbatim explicit DM_LANG precedence passed");
+}
diff --git a/dm/host/tests/t_mem_config.c b/dm/host/tests/t_mem_config.c
new file mode 100644
index 0000000000000000000000000000000000000000..790d5fd7782691bbbf886cc2f781f9729a2d27e9
--- /dev/null
+++ b/dm/host/tests/t_mem_config.c
@@ -0,0 +1,19 @@
+#include <assert.h>
+#include <stdio.h>
+#include "../dm_mem_config.h"
+int main(void) {
+    size_t n = 0, off = 0;
+    assert(dm_mem_parse("4294967296", &n) && n == 0x100000000ull);
+    assert(dm_mem_parse("0x140000000", &n) && n == 0x140000000ull);
+    const char *bad[] = {"", "0", "-1", "+1", " 42", "42 ", "42junk", "0x", "08", "18446744073709551616", "18446744073709551615", "9223372036854775808"};
+    for (unsigned i = 0; i < sizeof bad / sizeof *bad; i++) assert(!dm_mem_parse(bad[i], &n));
+    assert(dm_mem_layout(0x100000000ull, 0x10000000, 0x10000000, 0x4000, &off) && off == 0x30000000);
+    assert(dm_mem_layout(0x140000000ull, 0x118000000ull, 0x10000000, 0x4000, &off));
+    assert(!dm_mem_layout(0x10000000, 0x10000000, 0x10000000, 0x4000, &off));
+    assert(!dm_mem_layout(0x30000000, 0x10000000, 0x10000000, 0x4000, &off));
+    assert(!dm_mem_layout(0x100000000ull, SIZE_MAX, 0x10000000, 0x4000, &off));
+    assert(!dm_mem_layout(0x100000000ull, 0x10000001, 0x10000000, 0x4000, &off));
+    assert(!dm_mem_layout(0x100000000ull, 0x10000000, SIZE_MAX, 0x4000, &off));
+    assert(!dm_mem_layout(SIZE_MAX, 0x10000000, 0x10000000, 0x4000, &off));
+    puts("memory config: complete parsing, overflow, alignment and layout underflow checks passed");
+}
diff --git a/dm/host/tests/t_padmap.c b/dm/host/tests/t_padmap.c
new file mode 100644
index 0000000000000000000000000000000000000000..6c9245f1cf3e428d7b3cdb6d79f57e80aa58eddc
--- /dev/null
+++ b/dm/host/tests/t_padmap.c
@@ -0,0 +1,21 @@
+#include <assert.h>
+#include <stdio.h>
+#include "../dm_padmap.h"
+int main(void) {
+    assert(dm_padmap_kind("Switch Pro Controller", "Pro Controller") == DM_PADKIND_NINTENDO);
+    assert(dm_padmap_kind(NULL, "NINTENDO") == DM_PADKIND_NINTENDO);
+    assert(dm_padmap_kind("Joy-Con (L/R)", NULL) == DM_PADKIND_NINTENDO);
+    assert(dm_padmap_kind(NULL, NULL) == DM_PADKIND_XBOX);
+    assert(dm_padmap_kind("DualSense", "Sony") == DM_PADKIND_XBOX);
+    assert(dm_padmap_select("XBOX", "Switch Pro Controller", "Nintendo") == DM_PADKIND_XBOX);
+    assert(dm_padmap_select("Nintendo", "Xbox", "Microsoft") == DM_PADKIND_NINTENDO);
+    assert(dm_padmap_select("auto", "Switch", NULL) == DM_PADKIND_NINTENDO);
+    for (int bits = 0; bits < 16; bits++) {
+        int south = bits & 1, east = bits & 2, west = bits & 4, north = bits & 8;
+        uint64_t xbox = (south ? DM_BTN_A : 0) | (east ? DM_BTN_B : 0) | (west ? DM_BTN_X : 0) | (north ? DM_BTN_Y : 0);
+        uint64_t nintendo = (east ? DM_BTN_A : 0) | (south ? DM_BTN_B : 0) | (north ? DM_BTN_X : 0) | (west ? DM_BTN_Y : 0);
+        assert(dm_padmap_face(DM_PADKIND_XBOX, south, east, west, north) == xbox);
+        assert(dm_padmap_face(DM_PADKIND_NINTENDO, south, east, west, north) == nintendo);
+    }
+    puts("padmap: vendor detection, explicit overrides and 32 face combinations passed");
+}
