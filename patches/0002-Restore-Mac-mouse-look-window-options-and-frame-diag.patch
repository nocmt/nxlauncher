From a085578f2de0b390a36bef90b92a032e10c36b7e Mon Sep 17 00:00:00 2001
From: nocmt <nocmtone@gmail.com>
Date: Thu, 22 Oct 2026 11:58:37 +0800
Subject: [PATCH 2/6] Restore Mac mouse look, window options and frame
 diagnostics

Retain upstream fullscreen, display refresh reporting, backing scale and GameController input. Keep rounded bottom corners only while windowed, removing the mask on entry to fullscreen. Restore DM_MOUSE_PAD, DM_MOUSE_DIAG, DM_WINDOW_SIZE and the DM_FPS overlay without changing frame pacing. Release input on focus loss.
---
diff --git a/dm/host/front_mac.m b/dm/host/front_mac.m
index 421016548d9fde6a90a5cb363f0b202e507de965..392719d425f3ba7de1723a046a132134459031e8 100644
--- a/dm/host/front_mac.m
+++ b/dm/host/front_mac.m
@@ -2,9 +2,12 @@
 // Without DM_WINDOW: the guest runs directly on the current thread, behaving the same as with no front end (windowless tests use this).
 // The window is fullscreen-capable (the green button and ⌃⌘F); DM_FULLSCREEN starts it that way. ⌘Q quits; the left mouse button is the touchscreen.
 // Key map (Nintendo layout): WASD left stick, arrow keys D-pad, J=A K=B U=X I=Y, Q=L E=R, Z=ZL C=ZR, F=press left stick G=press right stick, Return=+ Tab=−, Space=shake the controller.
+// Mouse: left button touches the screen; DM_MOUSE_PAD=1 maps it to A. Right drag or unpressed movement drives the right stick.
+// DM_WINDOW_SIZE=WxH sets the initial size; DM_FPS=0 hides the FPS/frame-time overlay; DM_MOUSE_DIAG=1 logs input delivery.
 // Controllers: buttons by position as on the iPhone (right A, bottom B, top X, left Y), shoulders L R, triggers ZL ZR, Menu + Options −, both sticks and their presses.
 #import <Cocoa/Cocoa.h>
 #import <QuartzCore/CAMetalLayer.h>
+#import <QuartzCore/CATransaction.h>
 #import <Metal/Metal.h>
 #import <GameController/GameController.h>
 #include "dm.h"
@@ -14,16 +17,60 @@
 #include <signal.h>
 
 static CAMetalLayer *g_layer;
+static NSView *g_view;
+static NSWindow *g_win;
 static uint64_t g_btn;
 static int g_w, g_a, g_s, g_d;
+static int32_t g_look_x, g_look_y;
+static double g_look_until;
+static NSPoint g_last_mouse;
+static int g_mouse_seen, g_mouse_diag, g_mouse_pad;
+static long g_mouse_events, g_mouse_clicks;
+static uint64_t g_mouse_btn, g_fps_frames;
+static double g_fps_t;
+static NSTextField *g_fps_label;
+#define DM_WINDOW_CORNER 10.0
 
 void *front_metal_layer(void) { return (__bridge void *)g_layer; }
 static _Atomic int g_screen_fps;   // the window's screen's maximumFramesPerSecond, kept up to date when the window moves to another screen
 int front_screen_max_fps(void) { return g_screen_fps; }
 static void push(void) {
     int32_t lx = (g_d - g_a) * 32767, ly = (g_w - g_s) * 32767;
-    dm_input_set(g_btn, lx, ly, 0, 0);
+    dm_input_set(g_btn | g_mouse_btn, lx, ly, g_look_x, g_look_y);
 }
+static void look_delta(NSPoint p) {
+    if (!g_mouse_seen) { g_mouse_seen = 1; g_last_mouse = p; return; }
+    double dx = p.x - g_last_mouse.x, dy = p.y - g_last_mouse.y;
+    g_last_mouse = p;
+    g_look_x = (int32_t)fmax(-32767, fmin(32767, g_look_x + dx * 260));
+    g_look_y = (int32_t)fmax(-32767, fmin(32767, g_look_y + dy * 260));
+    g_look_until = CACurrentMediaTime() + 0.12;
+    push();
+}
+// Content-view mouse handling leaves title-bar, window-button and resize events to AppKit.
+@interface DmGameView : NSView @end
+@implementation DmGameView
+- (NSView *)hitTest:(NSPoint)p { return NSPointInRect(p, self.bounds) ? self : nil; }
+- (void)mouseDown:(NSEvent *)e {
+    if (g_mouse_pad) { g_mouse_btn |= DM_BTN_A; push(); return; }
+    [self mouseDragged:e];
+}
+- (void)mouseDragged:(NSEvent *)e {
+    if (g_mouse_pad) return;
+    NSPoint p = [self convertPoint:e.locationInWindow fromView:nil]; NSSize b = self.bounds.size;
+    double w = b.width, h = b.height;
+    if (w <= 0 || h <= 0) return;
+    if (w / h > 16.0 / 9.0) w = h * 16.0 / 9.0; else h = w * 9.0 / 16.0;   // the centered 16:9 picture the present fits into the view, as on the iPhone (DmGamepad.m)
+    double x0 = (b.width - w) / 2, y0 = (b.height - h) / 2;
+    dm_touch t = {0, (float)fmin(fmax((p.x - x0) / w, 0), 0.999), (float)fmin(fmax(1 - (p.y - y0) / h, 0), 0.999)};   // The AppKit view origin is at bottom left, the touchscreen origin is at top left
+    dm_touch_set(&t, 1);
+}
+- (void)mouseUp:(NSEvent *)e { (void)e; if (g_mouse_pad) { g_mouse_btn &= ~DM_BTN_A; push(); } else dm_touch_set(NULL, 0); }
+- (void)rightMouseDown:(NSEvent *)e { g_mouse_seen = 1; g_last_mouse = [self convertPoint:e.locationInWindow fromView:nil]; }
+- (void)rightMouseDragged:(NSEvent *)e { look_delta([self convertPoint:e.locationInWindow fromView:nil]); }
+- (void)rightMouseUp:(NSEvent *)e { (void)e; g_look_until = 0; g_look_x = g_look_y = 0; push(); }
+- (void)mouseMoved:(NSEvent *)e { if (![NSEvent pressedMouseButtons]) look_delta([self convertPoint:e.locationInWindow fromView:nil]); }
+@end
 static int key_bit(unsigned short code) {
     switch (code) {
         case 38: return 0;  case 40: return 1;  case 32: return 2;  case 34: return 3;    // J K U I → A B X Y
@@ -38,10 +85,51 @@ static void on_key(NSEvent *e, int down) {
     unsigned short c = e.keyCode;
     switch (c) { case 13: g_w = down; break; case 0: g_a = down; break; case 1: g_s = down; break; case 2: g_d = down; break; }
     int b = key_bit(c);
-    uint64_t m = b >= 0 ? 1ull << b : c == 49 ? DM_BTN_SHAKE : 0;   // Space: shaken while held
+    uint64_t m = b >= 0 ? 1ull << b : c == 49 ? DM_BTN_SHAKE : 0;
     g_btn = down ? (g_btn | m) : (g_btn & ~m);
     push();
 }
+static void layout_layer(void) {
+    if (!g_layer || !g_view) return;
+    [CATransaction begin]; [CATransaction setDisableActions:YES];
+    g_layer.frame = g_view.bounds;
+    g_layer.contentsScale = g_view.window ? g_view.window.backingScaleFactor : 1.0;
+    [CATransaction commit];
+    if (g_fps_label) g_fps_label.frame = NSMakeRect(MAX(0, g_view.bounds.size.width - 250), MAX(0, g_view.bounds.size.height - 66), 240, 26);
+}
+static void reset_input(void) {
+    g_btn = g_mouse_btn = 0; g_w = g_a = g_s = g_d = 0;
+    g_look_x = g_look_y = g_mouse_seen = 0; g_look_until = 0;
+    push(); dm_touch_set(NULL, 0); dm_pad_set(0, 0, 0, 0, 0);
+}
+static void tick(id timer) {
+    (void)timer;
+    if (CACurrentMediaTime() > g_look_until) {
+        g_look_x = (int32_t)(g_look_x * 0.75); g_look_y = (int32_t)(g_look_y * 0.75);
+        if (abs(g_look_x) < 200) g_look_x = 0;
+        if (abs(g_look_y) < 200) g_look_y = 0;
+    }
+    push();
+    static unsigned ticks;
+    if (g_mouse_diag && ++ticks % 30 == 0 && g_win) {
+        NSRect f = g_win.frame; NSPoint m = NSEvent.mouseLocation;
+        LOG("[ui] mouse diagnostic active=%d key=%d frame=%.0f,%.0f %.0fx%.0f mouse=%.0f,%.0f clicks=%ld", NSApp.isActive, g_win.isKeyWindow, f.origin.x, f.origin.y, f.size.width, f.size.height, m.x, m.y, g_mouse_clicks);
+    }
+    if (!g_fps_label) return;
+    uint64_t frame = dm_guest_frame(); double now = CACurrentMediaTime(), dt = now - g_fps_t;
+    if (dt >= 0.2) {
+        uint64_t df = frame - g_fps_frames;
+        g_fps_label.stringValue = [NSString stringWithFormat:@"%.1f fps   %.1f ms   frame %llu", df / dt, df ? dt * 1000.0 / df : 0, (unsigned long long)frame];
+        g_fps_t = now; g_fps_frames = frame;
+    }
+}
+@interface DmFrontTimer : NSObject
++ (void)start;
+@end
+@implementation DmFrontTimer
++ (void)start { [NSTimer scheduledTimerWithTimeInterval:1.0 / 30.0 target:[DmFrontTimer new] selector:@selector(onTick:) userInfo:nil repeats:YES]; }
+- (void)onTick:(NSTimer *)timer { tick(timer); }
+@end
 
 // Physical controllers (GameController) go to dm_pad_set, as the iPhone's do (DmGamepad.m read_pad, same layout): ORed with the keyboard, a non-zero stick wins.
 // DM_KEYS uses the same path, so a controller touched during a script takes it over
@@ -65,23 +153,6 @@ static void pad_read(GCExtendedGamepad *g) {
     if (!any) dm_pad_set(0, 0, 0, 0, 0);
 }
 
-// Mouse as a single-point touchscreen (front.h dm_touch_set): left button down / drag = finger 0, release = lifted. The content view takes the clicks,
-// not a window-wide event monitor, so clicks on the title bar, the window buttons and the resize edges still reach AppKit.
-@interface DmGameView : NSView @end
-@implementation DmGameView
-- (void)mouseDown:(NSEvent *)e { [self mouseDragged:e]; }
-- (void)mouseDragged:(NSEvent *)e {
-    NSPoint p = [self convertPoint:e.locationInWindow fromView:nil]; NSSize b = self.bounds.size;
-    double w = b.width, h = b.height;
