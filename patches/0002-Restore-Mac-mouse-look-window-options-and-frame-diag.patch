 typedef struct { void (*fn)(void); } guest_arg;
 static void *guest_tramp(void *p) {
     static char alt[65536];                       // The signal alternate stack is per thread; crash printing must also work on the guest thread
@@ -95,6 +166,7 @@ void front_run(void (*guest)(void)) {
         [NSApplication sharedApplication];
         [NSApp setActivationPolicy:NSApplicationActivationPolicyRegular];
         NSRect r = NSMakeRect(0, 0, 1280, 720);
+        { const char *e = getenv("DM_WINDOW_SIZE"); unsigned w, h; if (e && sscanf(e, "%ux%u", &w, &h) == 2 && w >= 640 && h >= 360) r = NSMakeRect(0, 0, w, h); }
         NSWindow *win = [[NSWindow alloc] initWithContentRect:r
                                                     styleMask:NSWindowStyleMaskTitled | NSWindowStyleMaskClosable | NSWindowStyleMaskResizable
                                                       backing:NSBackingStoreBuffered defer:NO];
@@ -102,13 +174,24 @@ void front_run(void (*guest)(void)) {
         // Fullscreen: without FullScreenPrimary the green button only zooms the window. The present path already scales
         // the game picture to fit the drawable with black bars around it, so fullscreen keeps the game's aspect ratio.
         win.collectionBehavior = NSWindowCollectionBehaviorFullScreenPrimary;
-        NSView *v = win.contentView = [[DmGameView alloc] initWithFrame:r];
-        v.wantsLayer = YES;
+        g_win = win;
+        win.minSize = NSMakeSize(640, 360);
+        win.acceptsMouseMovedEvents = YES;
+        g_mouse_pad = getenv("DM_MOUSE_PAD") && atoi(getenv("DM_MOUSE_PAD")) != 0;
+        g_mouse_diag = getenv("DM_MOUSE_DIAG") && strcmp(getenv("DM_MOUSE_DIAG"), "0");
+        DmGameView *v = [[DmGameView alloc] initWithFrame:r];
+        win.contentView = v; v.wantsLayer = YES;
+        v.layer.masksToBounds = YES; v.layer.cornerRadius = DM_WINDOW_CORNER;
+        v.layer.maskedCorners = kCALayerMinXMinYCorner | kCALayerMaxXMinYCorner;
+        v.layer.cornerCurve = kCACornerCurveContinuous;
+        g_view = v;
         g_layer = [CAMetalLayer layer];
         g_layer.device = MTLCreateSystemDefaultDevice();
         g_layer.pixelFormat = MTLPixelFormatBGRA8Unorm;
         g_layer.contentsScale = win.backingScaleFactor;
-        v.layer = g_layer;
+        g_layer.autoresizingMask = kCALayerWidthSizable | kCALayerHeightSizable;
+        g_layer.frame = v.bounds;
