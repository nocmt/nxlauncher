diff --git a/dm/tools/tests/test_no_runtime_capture.py b/dm/tools/tests/test_no_runtime_capture.py
new file mode 100644
index 0000000000000000000000000000000000000000..2ffeed08d721f9d3c2a029cbc3bddc2d65633dcb
--- /dev/null
+++ b/dm/tools/tests/test_no_runtime_capture.py
@@ -0,0 +1,69 @@
+"""Static build boundaries must reject before any guest process or file mutation."""
+import ast
+import importlib.util
+import os
+from pathlib import Path
+import unittest
+from unittest import mock
+
+REPO = Path(__file__).resolve().parents[3]
+spec = importlib.util.spec_from_file_location('nsp_no_runtime', REPO / 'scripts/build_ipa_from_nsp.py')
+nsp = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(nsp)
+
+
+class NoRuntimeTests(unittest.TestCase):
+    def test_cli_and_default(self):
+        self.assertFalse(nsp.parse_args([]).no_runtime_capture)
+        self.assertTrue(nsp.parse_args(['--no-runtime-capture']).no_runtime_capture)
+
+    def test_boot_boundary_precedes_files_and_processes(self):
+        with mock.patch.object(nsp.subprocess, 'Popen') as popen, mock.patch('builtins.open') as opened:
+            with self.assertRaisesRegex(nsp.BuildError, 'NX_RUNTIME_CAPTURE_REQUIRED'):
+                nsp.boot_mac('unused', 'unused', {'NX_NO_RUNTIME_CAPTURE': '1'}, Path('unused'), Path('unused'), 1)
+            popen.assert_not_called()
+            opened.assert_not_called()
+
+    def test_guard_allows_static_work(self):
+        self.assertIsNone(nsp.require_runtime_capture({}, 'static'))
+
+    def test_oodle_host_rejects_before_process(self):
+        spec = importlib.util.spec_from_file_location('no_runtime_uepak', REPO / 'dm/gfx/tools/uepak.py')
+        ue = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(ue)
+        with mock.patch('subprocess.Popen') as popen:
+            with self.assertRaisesRegex(RuntimeError, 'NX_RUNTIME_CAPTURE_REQUIRED'):
+                ue.OodleHost('unused', 'unused', {'NX_NO_RUNTIME_CAPTURE': '1'})
+            popen.assert_not_called()
+
+    def test_split_decoder_guard_precedes_every_worker_process(self):
+        # Compile the actual production function without importing unrelated optional readers.
+        source = ast.parse((REPO / 'dm/gfx/tools/shader_split.py').read_text())
+        function = next(n for n in source.body if isinstance(n, ast.FunctionDef) and n.name == 'oodle')
+        namespace = {'os': os, '_OODLE': None}
+        exec(compile(ast.Module(body=[function], type_ignores=[]), '<production oodle>', 'exec'), namespace)
+        with mock.patch.dict(os.environ, {'NX_NO_RUNTIME_CAPTURE': '1'}), mock.patch('subprocess.Popen') as popen:
+            with self.assertRaisesRegex(RuntimeError, 'NX_RUNTIME_CAPTURE_REQUIRED'):
+                namespace['oodle'](b'', 0)
+            popen.assert_not_called()
+
+    def test_guest_host_backstop_precedes_loading(self):
+        text = (REPO / 'dm/host/main.c').read_text()
+        body = text[text.index('static void host_preload('):]
+        self.assertLess(body.index('NX_RUNTIME_CAPTURE_REQUIRED'), body.index('load_modules('))
+        # Offline pipeline compilation is not guest execution and remains permitted.
+        body = text[text.index('int main('):]
+        self.assertLess(body.index('mtl_pso_prebuild_tool()'), body.index('host_preload('))
+
+    def test_no_unreviewed_host_process_boundaries(self):
+        tree = ast.parse((REPO / 'scripts/build_ipa_from_nsp.py').read_text())
+        launches = []
+        for fn in (n for n in tree.body if isinstance(n, ast.FunctionDef)):
+            for node in ast.walk(fn):
+                if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute) and node.func.attr == 'Popen':
+                    launches.append(fn.name)
+        self.assertEqual(sorted(launches), ['boot_mac', 'rewrite', 'run'])
+
+
+if __name__ == '__main__':
+    unittest.main()
