+def require_runtime_capture(env, reason):
+    if (env or os.environ).get('NX_NO_RUNTIME_CAPTURE') == '1':
+        raise BuildError('NX_RUNTIME_CAPTURE_REQUIRED: ' + reason + '; static build needs cached runtime data. The user must explicitly authorize running guest code before retrying without --no-runtime-capture.')
