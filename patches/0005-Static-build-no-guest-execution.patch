+            for k, n in (('standard', 'standard.ttf'), ('extension', 'nintendo_ext.ttf')))
+    except (OSError, ValueError, KeyError, TypeError): valid = False
+    if not valid: raise BuildError('invalid redistributable font policy result')
     PROG.end(str(host))
     return host, font
 
