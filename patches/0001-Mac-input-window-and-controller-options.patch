index 0000000000000000000000000000000000000000..465bfb09c0a1d570f2c0a8297bfc026cd6efb0a8
--- /dev/null
+++ b/dm/host/dm_padmap.h
@@ -0,0 +1,32 @@
+// Shared physical-controller face mapping. GameController names buttons by position:
+// A south, B east, X west, Y north. Preserve the legacy fork's glyph mapping:
+// Nintendo keeps Switch positions; Xbox, PlayStation and unknown pads use Xbox positions.
+// Detection comes from 7463eba:dm/host/dm_padmap.h (already tracked in its parent).
+#pragma once
+#include <stdint.h>
+#include <string.h>
+#include <strings.h>
+#include "dm_input.h"
+enum { DM_PADKIND_XBOX = 0, DM_PADKIND_NINTENDO = 1 };
+static inline int dm_padmap_has(const char *s, const char *word) {
+    size_t n = strlen(word);
+    for (; s && *s; s++) if (!strncasecmp(s, word, n)) return 1;
+    return 0;
+}
+static inline int dm_padmap_kind(const char *category, const char *vendor) {
+    static const char *const words[] = {"switch", "nintendo", "joy-con"};
+    for (unsigned i = 0; i < sizeof words / sizeof *words; i++)
+        if (dm_padmap_has(category, words[i]) || dm_padmap_has(vendor, words[i])) return DM_PADKIND_NINTENDO;
+    return DM_PADKIND_XBOX;
+}
+// An explicit Xbox override must not share a sentinel with automatic detection (Xbox is 0).
+static inline int dm_padmap_select(const char *override, const char *category, const char *vendor) {
+    if (override && !strcasecmp(override, "nintendo")) return DM_PADKIND_NINTENDO;
+    if (override && !strcasecmp(override, "xbox")) return DM_PADKIND_XBOX;
+    return dm_padmap_kind(category, vendor);
+}
+static inline uint64_t dm_padmap_face(int kind, int south, int east, int west, int north) {
+    if (kind == DM_PADKIND_NINTENDO)
+        return (east ? DM_BTN_A : 0) | (south ? DM_BTN_B : 0) | (north ? DM_BTN_X : 0) | (west ? DM_BTN_Y : 0);
+    return (south ? DM_BTN_A : 0) | (east ? DM_BTN_B : 0) | (west ? DM_BTN_X : 0) | (north ? DM_BTN_Y : 0);
+}
