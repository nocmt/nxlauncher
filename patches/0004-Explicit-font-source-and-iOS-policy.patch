From: NxLauncher maintainers
Subject: [PATCH] Explicit font source and redistributable iOS policy helper

Based on official main 201dfd1280684e9d3ceac8b644236fdac11b6cc2.

diff --git a/dm/ios/tools/build_ipa.sh b/dm/ios/tools/build_ipa.sh
index e2c174d17dacf682da88394562c7b102691eed79..cfc05ffb99f0db1e0faf0a96045f59f5524dc8ff 100755
--- a/dm/ios/tools/build_ipa.sh
+++ b/dm/ios/tools/build_ipa.sh
@@ -105,9 +105,12 @@ if [ -n "$LD" ] && [ "$LD" != "$DM_LANG" ]; then t "game language: the game has
 if [ -n "${DM_ENV_FILE:-}" ]; then cp "$DM_ENV_FILE" Gen/dm/env.txt || die "copy DM_ENV_FILE"; t "env: $(grep -v '^#' "$DM_ENV_FILE" | tr '\n' ' ')"; fi
 # The shader libraries go into the archive as DmIOS.app/msl/<folder> (main.m sets DM_MSL_DIR to it)
 if [ "$GFXAPI" = vulkan ]; then MSLDIR=vk; elif [ "$GFXAPI" = gl ]; then MSLDIR=gl; else MSLDIR=b-$V; fi
-# Shared-font stand-ins: standard = macOS's Arial Unicode (absent on iOS), Nintendo extension = button icons generated by make_ext_font.py (needs fontTools; FONT_PY names a python that has it)
-mkdir -p Gen/dm/font && cp "${STD_FONT:-/System/Library/Fonts/Supplemental/Arial Unicode.ttf}" Gen/dm/font/standard.ttf || die "copy standard font (STD_FONT=a TTF)"
-"${FONT_PY:-python3}" "$DM/tools/make_ext_font.py" Gen/dm/font/nintendo_ext.ttf > /dev/null || die "make_ext_font.py (pip install fonttools, or FONT_PY=python with fontTools)"
+# Launcher builds use the same verified, redistributable fonts as Mac exports.
+FONT_HELPER=${NXLAUNCHER_FONT_HELPER:-$(dirname "$DM")/../Scripts/font-policy.py}
+case "$FONT_HELPER" in /*) ;; *) die "NXLAUNCHER_FONT_HELPER must be an absolute path";; esac
+[ -f "$FONT_HELPER" ] || die "no font policy helper: set NXLAUNCHER_FONT_HELPER to Scripts/font-policy.py"
+"${FONT_PY:-python3}" "$FONT_HELPER" --repo "$(dirname "$DM")" --out "$PWD/Gen/dm/font" > "$W/font-policy.json" || die "redistributable font preparation failed"
+"${FONT_PY:-python3}" -c 'import json,sys; from pathlib import Path; d=json.load(open(sys.argv[1])); out=Path(sys.argv[2]).resolve(); assert d.get("redistributable") is True; assert Path(d["standard"]).resolve() == out/"standard.ttf"; assert Path(d["extension"]).resolve() == out/"nintendo_ext.ttf"; assert all((out/n).is_file() for n in ("standard.ttf","nintendo_ext.ttf"))' "$W/font-policy.json" "$PWD/Gen/dm/font" || die "invalid font policy result"
 # App icon: the game's own icon (icon.jpg saved from the control data by nx_extract, the English 256x256 one). DM_ICON can point at another image; by default the icon.jpg next to the RomFS is used.
 # It is scaled to a 1024x1024 PNG in the asset catalog Gen/Assets.xcassets (a single-size app icon; actool generates the other sizes); with neither, no icon is set and the home-screen icon is blank.
 # The catalog is always created (the project always lists it, see project.yml); without an icon it stays empty and DM_APPICON is not set
diff --git a/dm/tools/make_ext_font.py b/dm/tools/make_ext_font.py
index 67e21f36ef77f4674888f7b2bbfe02fefb1a7368..1fb348a42478b2fb47d96aec1d48ae482ace3898 100644
--- a/dm/tools/make_ext_font.py
+++ b/dm/tools/make_ext_font.py
@@ -1,8 +1,8 @@
 #!/usr/bin/env python3
 # Generate a stand-in for the "Nintendo extension" shared font (nintendo_ext.ttf): controller-button icons at the original private-use code points (A/B/X/Y, L/R/ZL/ZR/SL/SR, +/−, D-pad, stick direction arrows).
-# The host has no original system fonts; button icons in game text (e.g. Mario's GameMsg/Key.msbt: U+E0E0 = A button) render as "?" when the glyph is missing. Letters come from macOS's Arial Rounded Bold, knocked out of a solid plate.
+# The host has no original system fonts; button icons in game text (e.g. Mario's GameMsg/Key.msbt: U+E0E0 = A button) render as "?" when the glyph is missing. Letters come from the explicitly supplied font, knocked out of a solid plate.
 # Usage: make_ext_font.py out.ttf [letter-font.ttf]; needs fontTools (pip install fonttools)
-import math, sys
+import argparse, math, sys
 from fontTools.ttLib import TTFont
 from fontTools.fontBuilder import FontBuilder
 from fontTools.pens.ttGlyphPen import TTGlyphPen
@@ -127,5 +127,13 @@ def build(out, letter_font):
     print('%s: %d glyphs, %d code points' % (out, len(order), len(cmap)))
 
 if __name__ == '__main__':
-    if len(sys.argv) < 2: sys.exit(__doc__ or 'usage: make_ext_font.py out.ttf [letter-font.ttf]')
-    build(sys.argv[1], sys.argv[2] if len(sys.argv) > 2 else '/System/Library/Fonts/Supplemental/Arial Rounded Bold.ttf')
+    parser = argparse.ArgumentParser(description='Generate controller icons from an explicitly licensed letter font.')
+    parser.add_argument('out')
+    parser.add_argument('letter_font', nargs='?', help='legacy positional letter-font path')
+    parser.add_argument('--base-font', help='letter-font path (use an openly licensed font for redistribution)')
+    parser.add_argument('--no-system-font', action='store_true', help='require an explicit font; never use a system font')
+    args = parser.parse_args()
+    if args.base_font and args.letter_font: parser.error('give --base-font or the positional font, not both')
+    font = args.base_font or args.letter_font
+    if not font and args.no_system_font: parser.error('--no-system-font requires --base-font')
+    build(args.out, font or '/System/Library/Fonts/Supplemental/Arial Rounded Bold.ttf')
